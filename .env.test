# Test environment. Committed on purpose — every value here is a throwaway that
# only ever addresses a local container. NOTHING SECRET MAY BE ADDED TO THIS FILE.
#
# The suite loads this file and ONLY this file: tests/setup/global-db.ts calls
# dotenv with an explicit path and no fallback, so .env.local (which holds the
# real Supabase, Xendit, Resend and Upstash credentials, six of them Vercel
# Sensitive vars that cannot be read back if lost) is never touched by a test run.

# Must point at localhost and end in _test — global-db.ts refuses to run otherwise.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/crochette_test

# Signs the cart cookie. Any non-empty string works; this one is not a secret.
AUTH_SECRET=test-secret-not-used-outside-tests

# lib/security/rate-limit.ts constructs its Redis client at module scope, so
# these must parse as URLs for the module to import at all. No request is ever
# made to them — the limiter is mocked in tests.
KV_REST_API_URL=http://localhost:1/upstash-not-used-in-tests
KV_REST_API_TOKEN=test-token-not-used

# Studio inbox for owner-facing notifications. Not a real address — the email
# transport is mocked in every test; this only exists so the "also notify the
# studio" branch in lib/email/notifications.ts is exercised rather than skipped.
STUDIO_NOTIFY_EMAIL=studio@crochette.test

# Xendit's webhook token, so the route handler's constant-time check has
# something to compare against. Not a real key.
XENDIT_WEBHOOK_TOKEN=test-callback-token

# Deliberately absent: NEXT_PUBLIC_SENTRY_DSN. With no DSN, SENTRY_ENABLED is
# false and the logger's Sentry branch is inert, so tests never emit events.
