# Postgres connection string (Neon, Supabase, or Vercel Postgres — see doc §3.2/§3.3)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js v5 JWT signing secret, gates /admin — generate with `npx auth secret`
AUTH_SECRET=

# Vercel Blob read/write token — custom-order reference photo uploads
BLOB_READ_WRITE_TOKEN=

# Resend API key — confirmation emails for custom-order/contact submissions.
# Get one at resend.com. Without a verified sending domain, Resend only
# delivers to the email address on the Resend account itself, not to
# arbitrary customers — verify a domain once one exists (see update.md).
RESEND_API_KEY=

# Studio owner's inbox — gets a copy of every new custom-order/contact submission
STUDIO_NOTIFY_EMAIL=

# Xendit (cart/checkout payments — Stripe isn't available for PH accounts;
# switched from PayMongo to Xendit for broader international card acceptance).
# Get keys at dashboard.xendit.co/settings/developers#api-keys. Test and live
# keys are separate — use the TEST secret key here and in .env.local for local
# dev; only put the LIVE key in Vercel's Production environment once actually
# ready to take real payments. No public/publishable key is needed — Payment
# Session creation is entirely server-side.
XENDIT_SECRET_KEY=

# Static verification token Xendit sends back on every webhook request
# (x-callback-token header) — get this after registering the webhook endpoint
# at dashboard.xendit.co/settings/developers#callbacks
XENDIT_WEBHOOK_TOKEN=

# Upstash Redis (rate limiting — lib/security/rate-limit.ts). Provision via
# `vercel integration add upstash/upstash-kv` (Vercel Marketplace), which
# auto-populates both of these. Note the KV_* naming (legacy @vercel/kv
# compat) rather than UPSTASH_REDIS_REST_* — Redis.fromEnv() won't find
# these, which is why the client is constructed manually.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Sentry — error tracking only (no performance tracing, no session replay).
# Everything below is OPTIONAL: with NEXT_PUBLIC_SENTRY_DSN unset the SDK is
# never initialised, next.config.ts skips withSentryConfig entirely, and
# lib/observability/log.ts still writes structured JSON to stdout (readable and
# filterable in the Vercel log viewer) — the same lazy/inert contract as
# DATABASE_URL and RESEND_API_KEY. Create a project at sentry.io -> Next.js.
#
# NOTE: do NOT set these with `vercel env add` / `vercel env pull`. That command
# overwrites .env.local wholesale and has destroyed it twice on this project
# (the second time unrecoverably, because Vercel Sensitive vars can't be read
# back). Add them in the Vercel dashboard UI, and hand-edit .env.local locally.
# ---------------------------------------------------------------------------

# PUBLIC — intentionally shipped in the browser bundle so client-side errors can
# be reported. It is a write-only ingest endpoint, not a credential: it grants no
# read access to your Sentry data. This is the project's first NEXT_PUBLIC_* var.
# Do NOT mark it Sensitive in Vercel.
NEXT_PUBLIC_SENTRY_DSN=

# BUILD-TIME ONLY, SECRET — uploads source maps so stack traces show TypeScript
# instead of minified Turbopack output. Create at
# sentry.io/settings/account/api/auth-tokens/ with only the `project:releases`
# and `org:read` scopes. Mark as Sensitive in Vercel. Builds succeed without it;
# source-map upload is simply skipped and traces stay minified.
SENTRY_AUTH_TOKEN=

# BUILD-TIME ONLY, not secret — org and project slugs, needed to route the
# source-map upload. Only read when SENTRY_AUTH_TOKEN is also set. This org is in
# Sentry's EU region (note the .de. in the DSN host), so source-map upload also
# needs SENTRY_URL=https://de.sentry.io/
SENTRY_ORG=
SENTRY_PROJECT=

# Set to 1 to send events to Sentry from local dev. Off by default so local
# experiments don't burn quota or pollute the issue stream.
SENTRY_SEND_IN_DEV=
